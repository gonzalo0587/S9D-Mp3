{
  "name": "s9d-mp3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:electron:main": "tsc -p tsconfig.electron-main.json",
    "build:electron:preload": "tsc -p tsconfig.electron-preload.json",
    "build:electron": "npm run build:electron:main && npm run build:electron:preload",
    "watch:electron:main": "tsc -p tsconfig.electron-main.json --watch",
    "watch:electron:preload": "tsc -p tsconfig.electron-preload.json --watch",
    "dev": "npm run build:electron && concurrently \"vite\" \"npm run watch:electron:main\" \"npm run watch:electron:preload\" \"electron dist-electron/main.js\"",
    "build": "npm run build:electron && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}